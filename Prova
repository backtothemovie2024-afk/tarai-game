<!DOCTYPE html>
<html lang="it">
<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Seoyoon Power Up Panel</title>

<style>

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background:
        radial-gradient(
            circle at center,
            #3b2417 0%,
            #1b0e08 55%,
            #0c0704 100%
        );

    font-family: Arial, sans-serif;
}

/* ==================================================
   AREA DI PROVA
================================================== */

#stage {

    position: relative;

    width: 100%;
    height: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    overflow: hidden;
}


/* ==================================================
   PANNELLO COMPLETO
================================================== */

#panel {

    position: relative;

    width: min(88vw, 430px);

    aspect-ratio: 0.78;

    overflow: visible;

    filter:
        drop-shadow(
            0 18px 25px rgba(0,0,0,0.65)
        );

}


/* ==================================================
   CORNICE ESTERNA
================================================== */

.panel-frame {

    position: absolute;

    inset: 0;

    background:

        linear-gradient(
            135deg,
            #9b5b2e,
            #5c2d16 22%,
            #a96535 45%,
            #542812 70%,
            #8d4e27
        );

    clip-path: polygon(
        8% 0%,
        92% 0%,
        100% 8%,
        100% 92%,
        92% 100%,
        8% 100%,
        0% 92%,
        0% 8%
    );

    border-radius: 8px;

    box-shadow:
        inset 0 0 0 5px #3a1a0c,
        inset 0 0 0 8px #c27a43;

}


/* ==================================================
   PARTE INTERNA
================================================== */

.panel-inner {

    position: absolute;

    left: 5%;
    right: 5%;
    top: 5%;
    bottom: 5%;

    background:
        linear-gradient(
            180deg,
            #fffdf7,
            #f2e9d8
        );

    clip-path: polygon(
        7% 0%,
        93% 0%,
        100% 7%,
        100% 93%,
        93% 100%,
        7% 100%,
        0% 93%,
        0% 7%
    );

    border: 3px solid #4a2411;

    overflow: visible;

}


/* ==================================================
   DIAGONALE SUPERIORE
================================================== */

.diagonal {

    position: absolute;

    left: -1%;
    top: 0;

    width: 102%;
    height: 43%;

    background:

        repeating-linear-gradient(
            8deg,
            #8a4b25 0px,
            #8a4b25 10px,
            #713817 11px,
            #9b5a2c 18px
        );

    clip-path: polygon(
        0% 0%,
        100% 0%,
        100% 42%,
        0% 100%
    );

    border-bottom:
        4px solid #4b210e;

    z-index: 4;

}


/* ==================================================
   TEXTURE LEGNO
================================================== */

.diagonal::after {

    content: "";

    position: absolute;

    inset: 0;

    background:

        repeating-linear-gradient(
            170deg,
            transparent 0px,
            transparent 18px,
            rgba(255,210,150,0.13) 19px,
            transparent 22px
        );

}


/* ==================================================
   FASCIA NOME
================================================== */

.name-band {

    position: absolute;

    left: 8%;
    right: 8%;

    top: 43%;

    height: 13%;

    background:

        linear-gradient(
            180deg,
            #b86d38,
            #7c3e1c
        );

    border-top:
        4px solid #d18a50;

    border-bottom:
        4px solid #4c220f;

    display: flex;

    align-items: center;
    justify-content: center;

    z-index: 6;

    box-shadow:
        0 5px 8px rgba(0,0,0,0.3);

}


.name-band span {

    color: #fff4d8;

    font-size: clamp(
        25px,
        7vw,
        34px
    );

    font-weight: 900;

    letter-spacing: 3px;

    text-shadow:
        2px 3px 0 #4b1d0b,
        0 0 4px rgba(0,0,0,0.5);

}


/* ==================================================
   DESCRIZIONE
================================================== */

.description {

    position: absolute;

    left: 10%;
    right: 10%;

    top: 60%;

    height: 25%;

    display: flex;

    align-items: center;
    justify-content: center;

    text-align: center;

    padding:
        10px 18px;

    color: #4a2818;

    font-size: clamp(
        15px,
        4vw,
        21px
    );

    font-weight: 700;

    line-height: 1.25;

}


/* ==================================================
   ICONA COCKTAIL
================================================== */

.power-icon {

    position: absolute;

    left: 50%;

    top: 82%;

    width: 23%;

    aspect-ratio: 1;

    transform:
        translate(-50%, -50%);

    background:

        radial-gradient(
            circle,
            #fff9df 0%,
            #f1d79d 65%,
            #b77a39 100%
        );

    border:
        4px solid #6b3518;

    border-radius: 50%;

    display: flex;

    align-items: center;
    justify-content: center;

    z-index: 7;

    box-shadow:
        0 5px 8px rgba(0,0,0,0.4),
        inset 0 2px 4px rgba(255,255,255,0.7);

}

.power-icon img {

    width: 78%;
    height: 78%;

    object-fit: contain;

    filter:
        drop-shadow(
            0 3px 3px rgba(0,0,0,0.35)
        );

}


/* ==================================================
   LIVELLO
================================================== */

.level {

    position: absolute;

    right: 7%;
    bottom: 4%;

    min-width: 55px;
    height: 34px;

    padding:
        0 10px;

    background: #ef6428;

    border:
        3px solid white;

    border-radius: 18px;

    color: white;

    font-size: 17px;

    font-weight: 900;

    display: flex;

    align-items: center;
    justify-content: center;

    z-index: 10;

    text-shadow:
        1px 2px 2px #722300;

    box-shadow:
        0 3px 7px rgba(0,0,0,0.5);

}


/* ==================================================
   SEOYOON
================================================== */

#seoyoon {

    position: absolute;

    /*
       La facciamo sporgere
       dalla parte diagonale.
    */

    width: 72%;

    height: auto;

    left: 47%;

    top: -15%;

    transform:
        translateX(-50%);

    z-index: 20;

    pointer-events: none;

    filter:
        drop-shadow(
            0 7px 5px rgba(0,0,0,0.35)
        );

}


/* ==================================================
   LUCE SUL PERSONAGGIO
================================================== */

.character-glow {

    position: absolute;

    width: 55%;
    height: 35%;

    left: 45%;
    top: 5%;

    transform:
        translateX(-50%);

    background:
        radial-gradient(
            ellipse,
            rgba(255,215,150,0.22),
            transparent 70%
        );

    z-index: 15;

    pointer-events: none;

}


/* ==================================================
   TITOLO SUPERIORE
================================================== */

.title {

    position: absolute;

    top: 4%;

    left: 50%;

    transform:
        translateX(-50%);

    color: #ffe7b5;

    font-size: 15px;

    font-weight: 900;

    letter-spacing: 2px;

    z-index: 30;

    text-shadow:
        2px 2px 3px #000;

    opacity: 0.9;

}


/* ==================================================
   MOBILE
================================================== */

@media (max-width: 500px) {

    #panel {

        width: 90vw;

    }

    #seoyoon {

        width: 75%;

        top: -13%;

    }

}


/* ==================================================
   CANVAS NASCOSTO
================================================== */

#characterCanvas {

    display: none;

}

</style>

</head>

<body>


<div id="stage">


    <div id="panel">


        <!-- CORNICE -->

        <div class="panel-frame"></div>


        <!-- PARTE INTERNA -->

        <div class="panel-inner">


            <!-- DIAGONALE IN LEGNO -->

            <div class="diagonal"></div>


            <!-- LUCE -->

            <div class="character-glow"></div>


            <!-- TITOLO -->

            <div class="title">
                POWER UP
            </div>


            <!-- NOME -->

            <div class="name-band">

                <span>
                    SEOYOON
                </span>

            </div>


            <!-- DESCRIZIONE -->

            <div class="description">

                Throws cocktails with a chance
                to slow customers.

            </div>


            <!-- ICONA -->

            <div class="power-icon">

                <img
                    src="https://i.ibb.co/nqJ8Lh8w/Screenshot-20260830-210005-Grok-removebg-preview.png"
                    alt="Cocktail"
                >

            </div>


            <!-- LIVELLO -->

            <div class="level">
                NEW
            </div>


        </div>


        <!-- SEOYOON FUORI DAL PANNELLO -->

        <img
            id="seoyoon"
            alt="Seoyoon"
        >


    </div>


</div>


<!-- CANVAS USATO PER RIMUOVERE
     LO SFONDO NERO DAL JPG -->

<canvas
    id="characterCanvas">
</canvas>


<script>

/* ==================================================
   IMMAGINE ORIGINALE SEOYOON
================================================== */

const SEOYOON_IMAGE =
"https://i.ibb.co/YBKRnbCM/1787717800004-removebg-preview-2.jpg";


/* ==================================================
   CARICAMENTO SEOYOON
================================================== */

const source =
new Image();

source.crossOrigin =
"anonymous";

source.src =
SEOYOON_IMAGE;


/* ==================================================
   RIMOZIONE SFONDO NERO
================================================== */

source.onload =
function() {

    const canvas =
        document.getElementById(
            "characterCanvas"
        );

    const ctx =
        canvas.getContext(
            "2d"
        );

    canvas.width =
        source.naturalWidth;

    canvas.height =
        source.naturalHeight;

    ctx.drawImage(
        source,
        0,
        0
    );

    const imageData =
        ctx.getImageData(
            0,
            0,
            canvas.width,
            canvas.height
        );

    const data =
        imageData.data;


    /*
       Rimuoviamo solamente il nero
       collegato allo sfondo.

       I capelli rimangono perché
       non sono perfettamente neri
       come lo sfondo.
    */

    const visited =
        new Uint8Array(
            canvas.width *
            canvas.height
        );

    const queue = [];


    function addPixel(x, y) {

        if (
            x < 0 ||
            y < 0 ||
            x >= canvas.width ||
            y >= canvas.height
        ) {
            return;
        }

        const index =
            y *
            canvas.width +
            x;

        if (
            visited[index]
        ) {
            return;
        }

        visited[index] =
            1;

        const p =
            index * 4;

        const r =
            data[p];

        const g =
            data[p + 1];

        const b =
            data[p + 2];


        /*
           Solo colori molto scuri.
        */

        if (
            r < 35 &&
            g < 35 &&
            b < 35
        ) {

            queue.push(
                [x, y]
            );

        }

    }


    /*
       Partiamo dai bordi
    */

    for (
        let x = 0;
        x < canvas.width;
        x++
    ) {

        addPixel(
            x,
            0
        );

        addPixel(
            x,
            canvas.height - 1
        );

    }


    for (
        let y = 0;
        y < canvas.height;
        y++
    ) {

        addPixel(
            0,
            y
        );

        addPixel(
            canvas.width - 1,
            y
        );

    }


    /*
       Flood fill
    */

    let pointer = 0;


    while (
        pointer <
        queue.length
    ) {

        const [
            x,
            y
        ] =
            queue[pointer++];


        const index =
            (
                y *
                canvas.width +
                x
            ) * 4;


        data[index + 3] =
            0;


        addPixel(
            x + 1,
            y
        );

        addPixel(
            x - 1,
            y
        );

        addPixel(
            x,
            y + 1
        );

        addPixel(
            x,
            y - 1
        );

    }


    ctx.putImageData(
        imageData,
        0,
        0
    );


    /*
       Convertiamo il canvas
       in immagine trasparente.
    */

    const character =
        document.getElementById(
            "seoyoon"
        );

    character.src =
        canvas.toDataURL(
            "image/png"
        );

};

</script>

</body>
</html>
